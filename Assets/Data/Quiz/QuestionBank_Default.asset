  m_Name: QuestionBank_Default
  m_EditorClassIdentifier: 
  subjectName: Historia General
  questions:
  - questionText: "\xBFEn qu\xE9 a\xF1o lleg\xF3 Crist\xF3bal Col\xF3n a Am\xE9rica?"
    options:
    - 1492
    - 1520
    - 1402
    - 1500
    correctOptionIndex: 0
    hintText: Fue a finales del siglo XV.
  - questionText: "\xBFQui\xE9n escribi\xF3 'Don Quijote de la Mancha'?"
    options:
    - Lope de Vega
    - Miguel de Cervantes
    - Shakespeare
    - Garcilaso
    correctOptionIndex: 1
    hintText: "Es considerado el padre de la novela moderna espa\xF1ola."
  - questionText: "\xBFCu\xE1l es el resultado de 7 \xD7 8?"
    options:
    - 54
    - 58
    - 56
    - 48
    correctOptionIndex: 2
    hintText: "Es un n\xFAmero entre 50 y 60."
  - questionText: "\xBFCu\xE1l es el planeta m\xE1s grande del sistema solar?"
    options:
    - Saturno
    - Marte
    - Urano
    - "J\xFApiter"
    correctOptionIndex: 3
    hintText: Es un gigante gaseoso con una gran mancha roja.
  - questionText: "\xBFCu\xE1l es la capital de Francia?"
    options:
    - Madrid
    - Londres
    - "Par\xEDs"
    - "Berl\xEDn"
    correctOptionIndex: 2
    hintText: Es conocida como la 'Ciudad de la Luz'.
  - questionText: "\xBFQu\xE9 elemento qu\xEDmico tiene el s\xEDmbolo 'O'?"
    options:
    - Oro
    - Osmio
    - "Ox\xEDgeno"
    - "Oganes\xF3n"
    correctOptionIndex: 2
    hintText: "Es esencial para la respiraci\xF3n."
  - questionText: "\xBFEn qu\xE9 continente se encuentra Egipto?"
    options:
    - Asia
    - Europa
    - "\xC1frica"
    - "Ocean\xEDa"
    correctOptionIndex: 2
    hintText: "Las pir\xE1mides est\xE1n en este continente."
